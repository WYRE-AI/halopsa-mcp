# HaloPSA credentials for stdio and for HTTP only when AUTH_MODE=env.
# The gateway Compose service does not load these. Do not add them to that
# service's environment or via env_file. Gateway mode requires the
# X-Halo-Client-ID, X-Halo-Client-Secret, and X-Halo-Tenant (or
# X-Halo-Base-URL) headers on each request.
HALOPSA_CLIENT_ID=
HALOPSA_CLIENT_SECRET=
HALOPSA_TENANT=
# HALOPSA_BASE_URL=

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. With a real CONDUIT_S2S_SECRET, an
# unset MCP_HTTP_HOST stays 0.0.0.0 so container deploys keep the historical
# bind. The image and Compose set 0.0.0.0 inside the container and publish
# the host port on 127.0.0.1. MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# A non-loopback MCP_HTTP_HOST is overridden and that override is logged.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (changeme, your-s2s-secret, placeholder, secret, replace-me,
# replace-with-a-real-secret, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST is overridden to
# 127.0.0.1 and that override is logged.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Halo-* headers; no env fallback). The container image and Compose service
# set gateway. Stdio ignores this and reads HALOPSA_* from the environment.
# AUTH_MODE=env

LOG_LEVEL=info
